# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=insurance_warehouse

# Admin credentials (used only for DB migrations, schema setup, and seed scripts)
POSTGRES_ADMIN_USER=admin
POSTGRES_ADMIN_PASSWORD=admin_secret_pass

# Read-only agent credentials (used by FastMCP server & SQL Agent)
POSTGRES_READONLY_USER=readonly_agent
POSTGRES_READONLY_PASSWORD=readonly_secret_pass

# Execution guardrail defaults
STATEMENT_TIMEOUT_MS=10000
MAX_ROW_LIMIT=1000

# ==============================================================================
# LLM Provider Configuration
# ==============================================================================
# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini (optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Model Selection
DEFAULT_MODEL=gpt-4o-mini
DEFAULT_EMBEDDING_MODEL=text-embedding-3-small

# ==============================================================================
# Observability (Langfuse)
# ==============================================================================
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key
LANGFUSE_SECRET_KEY=your_langfuse_secret_key
LANGFUSE_HOST=https://cloud.langfuse.com

# ==============================================================================
# Vector Store / Schema Retrieval
# ==============================================================================
CHROMA_PERSIST_DIRECTORY=./data/chroma_db

# ==============================================================================
# FastMCP Server / App
# ==============================================================================
MCP_SERVER_HOST=0.0.0.0
MCP_SERVER_PORT=8000
API_PORT=8080
UI_PORT=8501
